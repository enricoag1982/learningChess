{
  "name": "chess-for-kids",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "pnpm --filter \"@learn/subject-*\" build",
    "dev": "pnpm --filter @learn/chess-kids dev",
    "dev:math": "pnpm --filter @learn/math-demo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:slow": "pnpm -r --if-present test:slow",
    "build": "pnpm -r build",
    "test:e2e": "pnpm --filter @learn/chess-kids test:e2e",
    "test:e2e:math": "pnpm --filter @learn/math-demo exec playwright test",
    "size": "pnpm --filter @learn/chess-kids size",
    "compat": "pnpm --filter @learn/chess-kids compat",
    "voice:check": "pnpm --filter @learn/subject-chess voice-check",
    "voice:generate": "pnpm --filter @learn/subject-chess voice-texts && python3 tools/voice/generate.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
