    "@vitejs/plugin-react": "^6.1.1",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
